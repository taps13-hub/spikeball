# For local use: copy to .env, then: set -a; source .env; set +a
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_BASE_URL=http://localhost:8000
TIME_ZONE=UTC
PGDATABASE=spikeball
# Local PostgreSQL uses your OS username and a Unix socket by default.
# For managed PostgreSQL, set DATABASE_URL instead of PG* variables.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/spikeball?sslmode=require
#
# Production: DEBUG=0, a generated secret, HTTPS public URL and allowed hostname.
# DJANGO_SECRET_KEY=REPLACE_WITH_A_GENERATED_SECRET
# TRUST_PROXY_HTTPS=1
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=REPLACE_ME
# EMAIL_HOST_PASSWORD=REPLACE_ME
# DEFAULT_FROM_EMAIL=spikeball@example.com
EMAIL_USE_TLS=1
INVITATION_DAYS=7
